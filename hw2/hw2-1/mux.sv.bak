module mux
	(
		input logic [2:0] a, sel, 
		output logic [7:0] y
	);

always_comb
	begin
		case(sel)
			0: y = a[3'b000];
			1: y = a[3'b001];
			2: y = a[3'b010];
			3: y = a[3'b011];
			4: y = a[3'b100];
			5: y = a[3'b101];
			6: y = a[3'b110];
			7: y = a[3'b111];
		endcase	
	end
endmodule